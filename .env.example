# Go reads process environment, not .env. Docker Compose loads .env automatically.
# REPO_HEALTH_PORT controls the published Docker port (and launcher process env).
REPO_HEALTH_PORT=8080
SOURCECRAFT_TOKEN=
# The following apply to direct native Go execution, not the Docker container.
HTTP_ADDR=127.0.0.1:8080
DATABASE_PATH=data/repo-health.db
